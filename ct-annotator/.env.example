# Copy to .env and edit. Defaults == the local dev stack. On a test
# server replace "localhost" with the server's hostname/IP -- the same
# values as the main platform's .env (PUBLIC_KEYCLOAK_URL must match
# exactly, it's the token issuer).
PUBLIC_KEYCLOAK_URL=http://localhost:8080
PUBLIC_ADMIN_UI_URL=http://localhost:5173
PUBLIC_ANNOTATOR_UI_URL=http://localhost:5174
# This app's own backend, as browsers reach it.
PUBLIC_ANNOTATOR_API=http://localhost:8010
# Same MinIO credentials as the main platform's .env.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
