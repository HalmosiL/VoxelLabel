# Copy to .env and edit. Every value has a localhost default in
# docker-compose.yml, so an empty .env == the local dev stack.
#
# For a test server, the ONE thing that matters is that browsers reach
# the services at these PUBLIC_* URLs: they're baked into admin-ui at
# build time and used by the services to validate tokens (the Keycloak
# issuer must be exactly the URL the browser logs in at). Replace
# "localhost" with the server's hostname or IP everywhere below, then
# `docker compose build` (see INSTALL.md).

# ---- where browsers reach things (hostname or IP of this server) ----
PUBLIC_KEYCLOAK_URL=http://localhost:8080
PUBLIC_ADMIN_UI_URL=http://localhost:5173
PUBLIC_ANNOTATOR_UI_URL=http://localhost:5174
PUBLIC_INGESTION_API=http://localhost:8001
PUBLIC_DATA_API=http://localhost:8002
PUBLIC_ANNOTATION_API=http://localhost:8003
PUBLIC_ADMIN_API=http://localhost:8004
# MinIO is fetched by browsers directly (presigned image/document URLs).
PUBLIC_MINIO_URL=http://localhost:9000
# Browser origins allowed to call the APIs (CORS): admin-ui, the viewer,
# and the clinician desktop app's local static server.
ADMIN_UI_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:45678

# ---- passwords: CHANGE THESE on any shared server ----
POSTGRES_USER=ctplatform
POSTGRES_PASSWORD=ctplatform
POSTGRES_DB=ctplatform
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# The confidential client admin-service uses for Keycloak's Admin API
# (created by infra/keycloak/setup-dev-realm.sh with this same value).
KEYCLOAK_ADMIN_CLIENT_SECRET=admin-service-account-secret

# ---- optional ----
# Which host interface the internal-only ports (Postgres, Redis, MinIO
# console, Ollama, Mailpit) are published on. 127.0.0.1 = only reachable
# from the server itself (recommended); 0.0.0.0 = from anywhere.
BIND_INTERNAL=127.0.0.1
# The local model the Clinical Trial Assistant card talks to.
OLLAMA_MODEL=qwen3:1.7b

# ---- for tools run on the host outside Docker (alembic, pytest) ----
DATABASE_URL=postgresql+psycopg://ctplatform:ctplatform@localhost:5432/ctplatform
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ct-pixel-data
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
KEYCLOAK_ISSUER=http://localhost:8080/realms/ct-platform
KEYCLOAK_AUDIENCE=ct-platform
